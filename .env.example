# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. NEVER commit the real .env —
# it is gitignored for a reason: these are live, billable credentials.
#
#   cp .env.example .env
#
# Only the first two are required. Everything else has a working default in
# app/config.py; set it here only to override.
# ---------------------------------------------------------------------------

# --- REQUIRED ---------------------------------------------------------------

# Sarvam AI — powers BOTH speech-to-text (Saaras) and text-to-speech (Bulbul).
# Get it at https://dashboard.sarvam.ai . A lapsed balance makes the bot play
# its greeting and then go silent, which looks like a crash but is not.
SARVAM_API_KEY=

# OpenAI — the conversation brain. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- MODELS (safe to leave blank) -------------------------------------------

# gpt-4.1-nano is the default: ~45% faster to first token and ~33% cheaper than
# gpt-4o-mini, and just as reliable on this heavily-ruled prompt. Fall back to
# gpt-4o-mini if a future prompt change trips nano up.
OPENAI_MODEL=gpt-4.1-nano
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# --- KNOWLEDGE BASE ---------------------------------------------------------

# Every file in this folder is loaded at startup and placed in the system
# prompt. There is no retrieval step; see the README.
KB_SOURCE_DIR=kb_source
KB_TOKEN_LIMIT=100000

# --- CALL BEHAVIOUR ---------------------------------------------------------

# true  = stream the mic to Sarvam's VAD over a WebSocket (barge-in, real
#         turn-taking). This is what phone calls use.
# false = the older record-and-POST browser flow.
STT_STREAMING=true
MAX_RECORDING_SECONDS=25

# --- SPEND LIMITS -----------------------------------------------------------

# Each turn costs roughly Rs 0.6, mostly TTS. These caps exist so a stuck
# client cannot drain the account. When the daily cap trips, callers hear a
# pre-rendered "lines are busy" line instead of dead air.
MAX_TURNS_PER_MINUTE=20
MAX_TURNS_PER_DAY=2000

# --- EXOTEL TELEPHONY (optional: leave blank for browser-only use) ----------

# Any two strings you choose. They become the Basic-auth credentials in the
# Voicebot Applet URL, which Exotel sends as an Authorization header:
#   wss://KEY:TOKEN@your-host/exotel/stream?sample-rate=16000
# Leave both blank and /exotel/stream accepts unauthenticated streams, which is
# fine for the local simulator and nothing else.
EXOTEL_WS_KEY=
EXOTEL_WS_TOKEN=

# --- ZOHO CRM (optional: leave blank and the bot simply greets generically) --

# With these set, an outbound call opens by the freshest lead's first name.
# Create a Self Client in the Zoho API console with scope ZohoCRM.modules.READ.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data centre: .in for India, or .com / .eu / .com.au
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
